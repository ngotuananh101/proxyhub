# Windows batch files must always use CRLF line endings — cmd.exe cannot
# parse LF-only .bat files, so force CRLF on checkout regardless of platform.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must keep LF endings so they run on Linux/macOS even when the
# repo is checked out on Windows with core.autocrlf=true.
*.sh text eol=lf
